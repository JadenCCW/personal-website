---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Folder name under src/assets/<dir>/ holding this entry's photos. */
  slug: string;
  dir?: 'photos' | 'closet';
  /** Describes the set, e.g. "Seoul, South Korea". Used for alt text. */
  alt: string;
}

const { slug, dir = 'photos', alt } = Astro.props;

// import.meta.glob needs a literal, compile-time pattern, so we glob every
// image once and filter down to this entry's folder. That means adding a
// photo is just dropping a file in a directory -- no code or frontmatter edit.
const all = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const prefix = `/src/assets/${dir}/${slug}/`;
const photos = Object.entries(all)
  .filter(([path]) => path.startsWith(prefix))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

{
  photos.length > 0 && (
    <div class="photos">
      {photos.map((image, i) => (
        <Image
          src={image}
          alt={`${alt} (${i + 1} of ${photos.length})`}
          widths={[600, 1000, 1600]}
          sizes="(max-width: 40rem) 100vw, 40rem"
          loading="lazy"
        />
      ))}
    </div>
  )
}
